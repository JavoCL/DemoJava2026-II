<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<StackPane prefHeight="150.0" prefWidth="300.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="cl.duoc.gestorbibliotecafx.controller.AgregarRecursoController">
    <children>
        <!-- VBox (Vertical Box) es un layout que permite ordenar los elementos hijos
               de forma vertical. -->
        <VBox alignment="CENTER" prefHeight="150.0" prefWidth="300.0">
            <children>
                <HBox alignment="CENTER_LEFT" layoutX="10.0" layoutY="240.0" prefHeight="100.0" prefWidth="200.0">
                    <children>
                        <Button fx:id="btnVolver" alignment="CENTER" layoutX="236.0" layoutY="22.0" mnemonicParsing="false" onAction="#Volver" text="&lt; volver" wrapText="true" />
                    </children>
               <padding>
                  <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
               </padding>
                </HBox>
                <HBox alignment="CENTER" prefHeight="100.0" prefWidth="200.0" spacing="15.0">
                    <children>
                        <Button fx:id="btnCrearLibro" layoutX="236.0" layoutY="22.0" mnemonicParsing="false" onAction="#CrearLibro" text="+Libro" wrapText="true" />
                  <Button fx:id="btnCrearPelicula" disable="true" layoutX="137.0" layoutY="57.0" mnemonicParsing="false" text="+Película" wrapText="true" />
                  <Button fx:id="btnCrearPeriodico" disable="true" layoutX="171.0" layoutY="57.0" mnemonicParsing="false" text="+Periódico" wrapText="true" />
                    </children>
                    <padding>
                        <Insets left="30.0" right="25.0" top="20.0" />
                    </padding>
                </HBox>
            </children>
        </VBox>
    </children>
</StackPane>
