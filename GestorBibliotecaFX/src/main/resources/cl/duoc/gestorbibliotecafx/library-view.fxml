<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<!-- 'BorderPane' es un layout que divide la ventana en 5 regiones: superior, inferior, centrar, izquierda y derecha -->
<!-- Como es el ancla (anchor o 'root') DEBE tener referencia al controlador de la vista.
     En este caso es 'cl.duoc.gestorbibliotecafx.LibraryController'-->

<BorderPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="533.0" prefWidth="765.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="cl.duoc.gestorbibliotecafx.controller.LibraryController">
   <!-- Region superior de BorderPane -->
   <top>
      <Label text="Sistema Gestion Biblioteca FX" textAlignment="CENTER" BorderPane.alignment="CENTER">
         <font>
            <Font name="System Bold" size="18.0" />
         </font>
         <BorderPane.margin>
            <Insets bottom="15.0" top="15.0" />
         </BorderPane.margin>
      </Label>
   </top>
      <!-- Region derecha de BorderPane -->
   <right>
      <!-- 'Pane' simple, que contiene botones de interaccion -->
      <Pane prefHeight="342.0" prefWidth="247.0" BorderPane.alignment="CENTER">
         <BorderPane.margin>
            <Insets bottom="30.0" right="30.0" />
         </BorderPane.margin>
         <children>
            <VBox alignment="CENTER" layoutY="-1.0" maxWidth="1.7976931348623157E308" minHeight="-Infinity" minWidth="-Infinity" prefHeight="450.0" prefWidth="250.0" spacing="50.0">
               <children>
                  <TitledPane collapsible="false" prefHeight="77.0" prefWidth="250.0" text="Nuevo Recurso">
                     <content>
                        <Button fx:id="btnAgregarRecurso" mnemonicParsing="false" onAction="#AgregarRecurso" text="+Agregar" />
                     </content></TitledPane>
                  <TitledPane collapsible="false" layoutX="10.0" layoutY="196.0" prefHeight="77.0" prefWidth="250.0" text="Nuevo Autor">
                     <content>
                        <Button fx:id="btnAgregarAutor" mnemonicParsing="false" onAction="#AgregarAutor" text="+Agregar" />
                     </content></TitledPane>
               </children></VBox>
         </children>
      </Pane>
   </right>
   <!-- Region central de BorderPane -->
   <center>
      <TabPane prefHeight="200.0" prefWidth="200.0" tabClosingPolicy="UNAVAILABLE" BorderPane.alignment="CENTER">
        <tabs>
          <Tab fx:id="tabRecursos" text="Recursos">
            <content>
              <AnchorPane minHeight="0.0" minWidth="0.0" prefHeight="180.0" prefWidth="200.0">
                     <children>
                        <TableView fx:id="tbvRecursos" prefHeight="410.0" prefWidth="450.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
                          <columns>
                            <TableColumn fx:id="tbcRecID" prefWidth="75.0" text="ID" />
                            <TableColumn fx:id="tbcRecTitulo" prefWidth="75.0" text="Titulo" />
                              <TableColumn fx:id="tbcRecFech" prefWidth="75.0" text="Fecha Pub" />
                          </columns>
                           <columnResizePolicy>
                              <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                           </columnResizePolicy>
                        </TableView>
                     </children>
                  </AnchorPane>
            </content>
          </Tab>
          <Tab disable="true" text="Untitled Tab 2">
            <content>
              <AnchorPane minHeight="0.0" minWidth="0.0" prefHeight="180.0" prefWidth="200.0" />
            </content>
          </Tab>
        </tabs>
         <BorderPane.margin>
            <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
         </BorderPane.margin>
      </TabPane>
   </center>
</BorderPane>
